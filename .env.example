# Copy to .env for local use. On Vercel, add the same names under Project Settings -> Environment Variables.
# Never commit .env.
PORT=3000

# Discord application: https://discord.com/developers/applications
# OAuth2 -> Redirects must contain: https://your-domain/auth/discord (local: http://localhost:3000/auth/discord)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Comma-separated Discord user IDs allowed to open the admin panel
ADMIN_IDS=

# Long random string used to sign login cookies
SESSION_SECRET=

# Storage for admin edits. Required on Vercel (its disk is read-only).
# Adding Upstash Redis from Vercel's Storage tab sets these for you
# (KV_REST_API_URL / KV_REST_API_TOKEN also work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
